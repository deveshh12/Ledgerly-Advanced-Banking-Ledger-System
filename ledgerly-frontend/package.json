{
  "name": "ledgerly-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:watch:css\" \"npm:start\"",
    "start": "node server.js",
    "build": "tailwindcss -i ./src/input.css -o ./public/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/output.css --watch"
  },
  "dependencies": { "express": "^5.2.1" },
  "devDependencies": { "concurrently": "^9.1.2", "tailwindcss": "^3.4.17" }
}
